{
  "name": "apo-photoshop",
  "main": "app/index.html",
  "version": "3.1.0",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "nwbuild --mode=run --glob=false --version=0.117.0 --cacheDir=./cache .",
    "build": "node scripts/build.mjs",
    "test": "jasmine-browser-runner runSpecs --config=test/jasmine-browser.json",
    "test:serve": "jasmine-browser-runner serve --config=test/jasmine-browser.json",
    "count": "find app/scripts/core -name '*.js' | xargs wc -l | sort -r"
  },
  "window": {
    "title": "APO Photoshop",
    "width": 1024,
    "height": 600,
    "toolbar": false,
    "frame": true,
    "icon": "app/images/app-icon.png"
  },
  "devDependencies": {
    "jasmine-browser-runner": "^5.0.0",
    "jasmine-core": "^7.0.2",
    "nw-builder": "^4.20.0"
  }
}
